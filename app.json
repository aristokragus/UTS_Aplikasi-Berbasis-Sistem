{
  "expo": {
    "name": "Baku Hisap Collective",
    "slug": "baku-hisap-collective",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bakuhisap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bakuhisap.collective"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
